{
  "version": "0.5-beta",
  "updated": "15-09-2026",
  "calculators": [
    {
      "id": "bmi",
      "type": "formula",
      "name": "Индекс массы тела (ИМТ)",
      "specialty": "Антропометрия",
      "description": "Оценка соответствия веса и роста взрослого человека",
  "fields": [
    { "id": "m_weight", "label": "Вес (кг)", "type": "number", "placeholder": "70", "step": "0.1" },
    { "id": "m_height", "label": "Рост (см)", "type": "number", "placeholder": "175", "step": "1" }
  ],
  "formula": "m_weight / ((m_height / 100) * (m_height / 100))",
      "unit": "кг/м²",
      "decimals": 1,
      "interpretation": [
        { "min": 0, "max": 18.5, "label": "Дефицит массы тела", "color": "#3b82f6" },
        { "min": 18.5, "max": 25, "label": "Норма", "color": "#22c55e" },
        { "min": 25, "max": 30, "label": "Избыточная масса тела", "color": "#f59e0b" },
        { "min": 30, "max": 35, "label": "Ожирение I степени", "color": "#ef4444" },
        { "min": 35, "max": 40, "label": "Ожирение II степени", "color": "#dc2626" },
        { "min": 40, "max": 999, "label": "Ожирение III степени", "color": "#991b1b" }
      ],
      "source": "ВОЗ, 2021"
    },
    {
      "id": "greene_scale",
      "type": "questionnaire",
      "name": "Шкала Грина (АиГ)",
      "specialty": "Акушерство и гинекология",
      "description": "Оценка выраженности климактерического синдрома (21 симптом)",
      "options": [
        { "value": 0, "label": "Нет" },
        { "value": 1, "label": "Слабо" },
        { "value": 2, "label": "Умеренно" },
        { "value": 3, "label": "Сильно" }
      ],
      "questions": [
        { "id": "q1",  "text": "Сердцебиение, перебои в работе сердца" },
        { "id": "q2",  "text": "Повышенная потливость" },
        { "id": "q3",  "text": "Приливы жара" },
        { "id": "q4",  "text": "Нарушения сна" },
        { "id": "q5",  "text": "Раздражительность" },
        { "id": "q6",  "text": "Тревожность, беспокойство" },
        { "id": "q7",  "text": "Подавленность, депрессия" },
        { "id": "q8",  "text": "Плаксивость" },
        { "id": "q9",  "text": "Быстрая утомляемость" },
        { "id": "q10", "text": "Снижение работоспособности" },
        { "id": "q11", "text": "Головные боли" },
        { "id": "q12", "text": "Головокружение" },
        { "id": "q13", "text": "Онемение, покалывание в конечностях" },
        { "id": "q14", "text": "Боли в мышцах и суставах" },
        { "id": "q15", "text": "Сухость кожи" },
        { "id": "q16", "text": "Сухость слизистых (глаза, рот)" },
        { "id": "q17", "text": "Изменения в сексуальной жизни" },
        { "id": "q18", "text": "Снижение либидо" },
        { "id": "q19", "text": "Нарушения мочеиспускания" },
        { "id": "q20", "text": "Прибавка в весе" },
        { "id": "q21", "text": "Отечность" }
      ],
      "scoring": "sum",
      "interpretation": [
        { "min": 0,  "max": 11,  "label": "Слабая степень тяжести",   "color": "#22c55e" },
        { "min": 12, "max": 19,  "label": "Средняя степень тяжести",  "color": "#f59e0b" },
        { "min": 20, "max": 999, "label": "Тяжёлая степень тяжести",  "color": "#ef4444" }
      ],
      "source": "Клинические рекомендации РОАГ «Менопауза и климактерическое состояние у женщины», 2021"
    },
    {
  "id": "tanner",
  "type": "formula",
  "name": "Индекс Таннера (ИМТ для детей и подростков, упрощённый)",
  "specialty": "Педиатрия",
  "description": "Оценка ИМТ для детей старше 5 лет (без учёта возрастных центилей)",
  "fields": [
    { "id": "m_weight", "label": "Вес (кг)", "type": "number", "placeholder": "45", "step": "0.1" },
    { "id": "m_height", "label": "Рост (см)", "type": "number", "placeholder": "155", "step": "1" }
  ],
  "formula": "m_weight / ((m_height / 100) * (m_height / 100))",
  "unit": "кг/м²",
  "decimals": 1,
  "interpretation": [
    { "min": 0,    "max": 14,   "label": "Выраженный дефицит",   "color": "#3b82f6" },
    { "min": 14,   "max": 18.5, "label": "Дефицит массы",        "color": "#60a5fa" },
    { "min": 18.5, "max": 25,   "label": "Норма",                "color": "#22c55e" },
    { "min": 25,   "max": 30,   "label": "Избыток массы",        "color": "#f59e0b" },
    { "min": 30,   "max": 999,  "label": "Ожирение",             "color": "#ef4444" }
  ],
  "source": "ВОЗ. Оценка физического развития детей 5-19 лет. Женева: ВОЗ, 2007 (упрощённые пороги)"
    },
        {
      "id": "ideal_weight_broca",
      "type": "formula",
      "name": "Идеальный вес (формула Брока)",
      "specialty": "Антропометрия",
      "description": "Расчёт идеальной массы тела для взрослых (рост − 110)",
      "fields": [
        { "id": "m_height", "label": "Рост (см)", "type": "number", "placeholder": "175", "step": "1" }
      ],
      "formula": "m_height - 110",
      "unit": "кг",
      "decimals": 0,
      "interpretation": [
        { "min": 0,   "max": 999, "label": "Идеальный вес для взрослого", "color": "#22c55e" }
      ],
      "source": "Формула Поля Брока, 1871"
    },    
     {
      "id": "body_surface_mosteller",
      "type": "formula",
      "name": "Площадь поверхности тела (Мостеллер)",
      "specialty": "Антропометрия",
      "description": "Расчёт площади поверхности тела для дозирования лекарств",
      "fields": [
        { "id": "m_weight", "label": "Вес (кг)", "type": "number", "placeholder": "70", "step": "0.1" },
        { "id": "m_height", "label": "Рост (см)", "type": "number", "placeholder": "175", "step": "1" }
      ],
      "formula": "Math.sqrt((m_weight * m_height) / 3600)",
      "unit": "м²",
      "decimals": 2,
      "interpretation": [
        { "min": 0, "max": 999, "label": "Площадь поверхности тела", "color": "#22c55e" }
      ],
      "source": "Mosteller RD, N Engl J Med, 1987"
    },
    {
  "id": "bishop_score",
  "type": "questionnaire",
  "name": "Шкала Бишопа (зрелость шейки матки)",
  "specialty": "Акушерство",
  "description": "Оценка степени зрелости шейки матки для прогноза успешности индукции родов",
  "scoring": "sum",
  "questions": [
    {
      "id": "q1",
      "text": "Раскрытие наружного зева",
      "options": [
        { "value": 0, "label": "<1 см" },
        { "value": 1, "label": "1–2 см" },
        { "value": 2, "label": "2–4 см" },
        { "value": 3, "label": ">4 см" }
      ]
    },
    {
      "id": "q2",
      "text": "Длина шейки матки",
      "options": [
        { "value": 0, "label": ">4 см" },
        { "value": 1, "label": "2–4 см" },
        { "value": 2, "label": "1–2 см" },
        { "value": 3, "label": "<1 см" }
      ]
    },
    {
      "id": "q3",
      "text": "Консистенция шейки матки",
      "options": [
        { "value": 0, "label": "Плотная" },
        { "value": 1, "label": "Умеренно размягчена" },
        { "value": 2, "label": "Мягкая" }
      ]
    },
    {
      "id": "q4",
      "text": "Положение шейки относительно оси таза",
      "options": [
        { "value": 0, "label": "Кзади" },
        { "value": 1, "label": "По центру" },
        { "value": 2, "label": "Кпереди" }
      ]
    },
    {
      "id": "q5",
      "text": "Положение головки плода",
      "options": [
        { "value": 0, "label": "−3" },
        { "value": 1, "label": "−2" },
        { "value": 2, "label": "−1 или 0" },
        { "value": 3, "label": "+1 или +2" }
      ]
    }
  ],
  "interpretation": [
    { "min": 0, "max": 6, "label": "Незрелая шейка матки", "color": "#ef4444" },
    { "min": 6, "max": 8, "label": "Недостаточно зрелая", "color": "#f59e0b" },
    { "min": 8, "max": 14, "label": "Зрелая шейка матки", "color": "#22c55e" }
  ],
  "source": "Bishop EH. Pelvic scoring for elective induction. Obstet Gynecol. 1964;24:266-268"
    },
    {
  "id": "ideal_weight_devine",
  "type": "formula",
  "name": "Идеальная масса тела (формула Девина)",
  "specialty": "Антропометрия",
  "description": "Расчёт идеальной массы тела для дозирования лекарств (стандарт для аминогликозидов, вентиляции)",
  "fields": [
    { "id": "m_height", "label": "Рост (см)", "type": "number", "placeholder": "175", "step": "1" },
    {
      "id": "m_sex",
      "label": "Пол",
      "type": "radio",
      "options": [
        { "value": 1, "label": "Мужской" },
        { "value": 0, "label": "Женский" }
      ]
    }
  ],
  "formula": "m_sex === 1 ? (50 + 2.3 * (m_height / 2.54 - 60)) : (45.5 + 2.3 * (m_height / 2.54 - 60))",
  "unit": "кг",
  "decimals": 1,
  "interpretation": [
    { "min": 0, "max": 999, "label": "Идеальная масса тела", "color": "#22c55e" }
  ],
  "source": "Devine BJ. Gentamicin therapy. Drug Intell Clin Pharm. 1974;8:650-655"
    },
    {
  "id": "lean_body_mass_james",
  "type": "formula",
  "name": "Масса обезжиренного тела (формула Джеймса)",
  "specialty": "Антропометрия",
  "description": "Оценка массы обезжиренного тела (мышцы, кости, органы) для фармакокинетических расчётов",
  "fields": [
    { "id": "m_weight", "label": "Вес (кг)", "type": "number", "placeholder": "70", "step": "0.1" },
    { "id": "m_height", "label": "Рост (см)", "type": "number", "placeholder": "175", "step": "1" },
    {
      "id": "m_sex",
      "label": "Пол",
      "type": "radio",
      "options": [
        { "value": 1, "label": "Мужской" },
        { "value": 0, "label": "Женский" }
      ]
    }
  ],
  "formula": "m_sex === 1 ? (1.10 * m_weight - 128 * (m_weight / m_height) ** 2) : (1.07 * m_weight - 148 * (m_weight / m_height) ** 2)",
  "unit": "кг",
  "decimals": 1,
  "interpretation": [
    { "min": 0, "max": 999, "label": "Масса обезжиренного тела", "color": "#22c55e" }
  ],
  "source": "James WPT. Research on obesity. London: Her Majesty's Stationery Office, 1976"
    },
    {
  "id": "nagele_rule",
  "type": "formula",
  "name": "Правило Негеле (ПДР)",
  "specialty": "Акушерство",
  "description": "Расчёт предполагаемой даты родов по первому дню последней менструации",
  "fields": [
    { "id": "m_lmp", "label": "Первый день последней менструации", "type": "date" }
  ],
  
  "formula": "(() => { const d = new Date(m_lmp); d.setDate(d.getDate() + 7); d.setMonth(d.getMonth() - 3); d.setFullYear(d.getFullYear() + 1); return d.toLocaleDateString('ru-RU'); })()",
  "unit": "",
  "decimals": 0,
  "interpretation": [
    { "min": 0, "max": 999, "label": "Предполагаемая дата родов", "color": "#22c55e" }
  ],
  "source": "Naegele F. 1812; адаптировано ВОЗ"
    },
    {
  "id": "mayo_score",
  "type": "questionnaire",
  "name": "Mayo Score (активность язвенного колита)",
  "specialty": "Гастроэнтерология",
  "description": "Клинико-эндоскопический индекс активности язвенного колита. Сумма 4 параметров (0–12).",
  "scoring": "sum",
  "questions": [
    { "id": "q1", "text": "Частота стула", "options": [
      { "value": 0, "label": "Обычная" },
      { "value": 1, "label": "На 1–2 больше" },
      { "value": 2, "label": "На 3–4 больше" },
      { "value": 3, "label": "На 5+ больше" }
    ]},
    { "id": "q2", "text": "Ректальное кровотечение", "options": [
      { "value": 0, "label": "Нет" },
      { "value": 1, "label": "Прожилки <50%" },
      { "value": 2, "label": "Видимая кровь" },
      { "value": 3, "label": "Преимущественно кровь" }
    ]},
    { "id": "q3", "text": "Эндоскопическая картина", "options": [
      { "value": 0, "label": "Норма / неактивно" },
      { "value": 1, "label": "Лёгкая (эритема, снижение сосудистого рисунка)" },
      { "value": 2, "label": "Умеренная (выраженная эритема, эрозии)" },
      { "value": 3, "label": "Тяжёлая (язвы, спонтанное кровотечение)" }
    ]},
    { "id": "q4", "text": "Общая оценка врачом", "options": [
      { "value": 0, "label": "Норма" },
      { "value": 1, "label": "Лёгкая" },
      { "value": 2, "label": "Средняя" },
      { "value": 3, "label": "Тяжёлая" }
    ]}
  ],
  "interpretation": [
    { "min": 0,  "max": 3,  "label": "Ремиссия",             "color": "#22c55e" },
    { "min": 3,  "max": 6,  "label": "Лёгкая атака",         "color": "#f59e0b" },
    { "min": 6,  "max": 11, "label": "Среднетяжёлая атака",  "color": "#f97316" },
    { "min": 11, "max": 999, "label": "Тяжёлая атака",        "color": "#ef4444" }
  ],
  "source": "Schroeder KW, Tremaine WJ, Ilstrup DM. Coated oral 5-aminosalicylic acid therapy for mildly to moderately active ulcerative colitis. N Engl J Med. 1987;317(26):1625-1629"
    },
    {
  "id": "whr",
  "type": "formula",
  "name": "Индекс талия/бедро (WHR)",
  "specialty": "Антропометрия",
  "description": "Оценка абдоминального ожирения и кардиометаболического риска. ВОЗ: мужчины > 0,90 и женщины > 0,85 указывают на центральное ожирение.",
  "fields": [
    { "id": "m_waist", "label": "Окружность талии (см)", "type": "number", "placeholder": "85", "step": "0.5" },
    { "id": "m_hip", "label": "Окружность бёдер (см)", "type": "number", "placeholder": "100", "step": "0.5" },
    {
      "id": "m_sex",
      "label": "Пол",
      "type": "radio",
      "options": [
        { "value": 1, "label": "Мужской" },
        { "value": 0, "label": "Женский" }
      ]
    }
  ],
  "formula": "m_waist / m_hip",
  "unit": "",
  "decimals": 2,
  "interpretation": [
    { "min": 0, "max": 999, "if": "m_sex === 1 && value > 0.90", "label": "Повышенный риск (мужчины, центральное ожирение)", "color": "#ef4444" },
    { "min": 0, "max": 999, "if": "m_sex === 0 && value > 0.85", "label": "Повышенный риск (женщины, центральное ожирение)", "color": "#ef4444" },
    { "min": 0, "max": 0.85, "label": "Норма (низкий риск)", "color": "#22c55e" },
    { "min": 0.85, "max": 0.90, "label": "Пограничная зона (мужчины — норма, женщины — повышенный риск)", "color": "#f59e0b" },
    { "min": 0.90, "max": 999, "label": "Повышенный риск (для обоих полов)", "color": "#ef4444" }
  ],
  "source": "WHO. Waist Circumference and Waist-Hip Ratio: Report of a WHO Expert Consultation. Geneva: WHO, 2008 (published 2011)"
   },
   {
  "id": "truelove_witts",
  "type": "questionnaire",
  "name": "Критерии Трулав-Виттса (тяжесть язвенного колита)",
  "specialty": "Гастроэнтерология",
  "description": "Классические критерии оценки тяжести атаки язвенного колита. Тяжёлая атака: ≥ 6 дефекаций с кровью в сутки + системные проявления. Лёгкая атака: < 4 дефекаций без системных проявлений.",
  "scoring": "logic",
  "interpretationMode": "logic",
  "questions": [
    { "id": "q1", "text": "Количество дефекаций с кровью в сутки", "options": [
      { "value": 0, "label": "< 4 раз" },
      { "value": 1, "label": "4–5 раз" },
      { "value": 2, "label": "≥ 6 раз" }
    ]},
    { "id": "q2", "text": "Температура тела", "options": [
      { "value": 0, "label": "≤ 37,8 °C" },
      { "value": 1, "label": "> 37,8 °C" }
    ]},
    { "id": "q3", "text": "Частота пульса", "options": [
      { "value": 0, "label": "≤ 90 уд/мин" },
      { "value": 1, "label": "> 90 уд/мин" }
    ]},
    { "id": "q4", "text": "Гемоглобин", "options": [
      { "value": 0, "label": "≥ 10,5 г/дл" },
      { "value": 1, "label": "< 10,5 г/дл" }
    ]},
    { "id": "q5", "text": "СОЭ (или СРБ)", "options": [
      { "value": 0, "label": "≤ 30 мм/ч" },
      { "value": 1, "label": "> 30 мм/ч (или СРБ > 30 мг/л)" }
    ]}
  ],
  "interpretation": [
    { "if": "q1 === 2 && (q2 === 1 || q3 === 1 || q4 === 1 || q5 === 1)", "label": "Тяжёлая атака (острая тяжёлая язвенная колит)", "color": "#ef4444" },
    { "if": "q1 === 0 && q2 === 0 && q3 === 0 && q4 === 0 && q5 === 0", "label": "Лёгкая атака", "color": "#22c55e" },
    { "min": 0, "max": 999, "label": "Средняя атака (промежуточное состояние)", "color": "#f59e0b" }
  ],
  "source": "Truelove SC, Witts LJ. Cortisone in ulcerative colitis; final report on a therapeutic trial. Br Med J. 1955;2(4947):1041-1048. (Современное применение см.: NHS Scotland. Acute severe colitis, 2024; ECCO Guidelines)"
   },
   {
  "id": "caprini",
  "type": "questionnaire",
  "name": "Шкала Каприни (Caprini Risk Score)",
  "specialty": "Хирургия / Флебология",
  "description": "Оценка риска венозных тромбоэмболических осложнений (ВТЭО) у хирургических пациентов. Введите вес и рост — ИМТ рассчитается автоматически.",
  "scoring": "sum",
  "preFields": [
    { "id": "m_weight", "label": "Вес (кг)", "type": "number", "placeholder": "70", "step": "0.1" },
    { "id": "m_height", "label": "Рост (см)", "type": "number", "placeholder": "175", "step": "1" }
  ],
  "calc": [
    { "id": "m_bmi", "formula": "m_weight / ((m_height / 100) ** 2)", "decimals": 1, "label": "ИМТ", "unit": "кг/м²" }
  ],
  "interpretation": [
    { "min": 0, "max": 2, "label": "Очень низкий риск ВТЭО (0–1 балл). Частота < 0,5%. Специфических мероприятий не требуется; рекомендована ранняя активизация больного.", "color": "#22c55e" },
    { "min": 2, "max": 3, "label": "Низкий риск ВТЭО (2 балла). Частота ~ 1,5%. Рекомендована ранняя активизация; при необходимости — механическая профилактика.", "color": "#84cc16" },
    { "min": 3, "max": 5, "label": "Умеренный риск ВТЭО (3–4 балла). Частота ~ 3%. Рекомендована фармакологическая или механическая профилактика.", "color": "#f59e0b" },
    { "min": 5, "max": 999, "label": "Высокий риск ВТЭО (≥ 5 баллов). Частота ~ 6%. Рекомендована продлённая фармакологическая профилактика (до 4 недель).", "color": "#ef4444" }
  ],
  "questions": [
    { "id": "q01", "text": "Возраст 41–60 лет", "type": "check", "points": 1 },
    { "id": "q02", "text": "Возраст 61–74 года", "type": "check", "points": 2 },
    { "id": "q03", "text": "Возраст 75 лет и старше", "type": "check", "points": 3 },
    { "id": "q04", "text": "ИМТ > 25 кг/м²", "type": "check", "points": 1, "auto": "m_bmi > 25" },
    { "id": "q05", "text": "Отеки нижних конечностей (в данный момент)", "type": "check", "points": 1 },
    { "id": "q06", "text": "Варикозные вены (видимые выпуклые вены)", "type": "check", "points": 1 },
    { "id": "q07", "text": "Сепсис (давностью < 1 мес.)", "type": "check", "points": 1 },
    { "id": "q08", "text": "Тяжёлое заболевание лёгких (в т.ч. пневмония < 1 мес.)", "type": "check", "points": 1 },
    { "id": "q09", "text": "Приём оральных контрацептивов или ГЗТ", "type": "check", "points": 1 },
    { "id": "q10", "text": "Беременность или послеродовый период (< 1 мес.)", "type": "check", "points": 1 },
    { "id": "q11", "text": "В анамнезе: необъяснимые мертворождения, повторные выкидыши, ребёнок с задержкой роста", "type": "check", "points": 1 },
    { "id": "q12", "text": "Острый инфаркт миокарда (< 1 мес.)", "type": "check", "points": 1 },
    { "id": "q13", "text": "Хроническая сердечная недостаточность (сейчас или < 1 мес.)", "type": "check", "points": 1 },
    { "id": "q14", "text": "Постельный режим (нехирургический пациент)", "type": "check", "points": 1 },
    { "id": "q15", "text": "Постельный режим > 72 часов", "type": "check", "points": 2 },
    { "id": "q16", "text": "Воспалительные заболевания толстой кишки в анамнезе", "type": "check", "points": 1 },
    { "id": "q17", "text": "ХОБЛ", "type": "check", "points": 1 },
    { "id": "q18", "text": "Злокачественное новообразование (в настоящее время или ранее)", "type": "check", "points": 2 },
    { "id": "q19", "text": "Иммобилизация конечности (гипс/ортез — давностью < 1 мес.)", "type": "check", "points": 2 },
    { "id": "q20", "text": "Личный анамнез ВТЭО (ТГВ/ТЭЛА)", "type": "check", "points": 3 },
    { "id": "q21", "text": "Семейный анамнез ВТЭО", "type": "check", "points": 3 },
    { "id": "q22", "text": "Мутация фактора V (Лейден)", "type": "check", "points": 3 },
    { "id": "q23", "text": "Мутация протромбина 20210A", "type": "check", "points": 3 },
    { "id": "q24", "text": "Гипергомоцистеинемия", "type": "check", "points": 3 },
    { "id": "q25", "text": "Гепарин-индуцированная тромбоцитопения", "type": "check", "points": 3 },
    { "id": "q26", "text": "Повышенный уровень антител к кардиолипину", "type": "check", "points": 3 },
    { "id": "q27", "text": "Волчаночный антикоагулянт", "type": "check", "points": 3 },
    { "id": "q28", "text": "Другая наследственная или приобретённая тромбофилия", "type": "check", "points": 3 },
    { "id": "q29", "text": "Инсульт (< 1 мес.)", "type": "check", "points": 5 },
    { "id": "q30", "text": "Повреждение спинного мозга с параличом (< 1 мес.)", "type": "check", "points": 5 },
    { "id": "q31", "text": "Катетеризация центральных вен (< 1 мес.)", "type": "check", "points": 2 },
    { "id": "q32", "text": "Малое хирургическое вмешательство (< 45 мин)", "type": "check", "points": 1 },
    { "id": "q33", "text": "Артроскопическая операция", "type": "check", "points": 2 },
    { "id": "q34", "text": "Лапароскопическая операция (> 60 мин)", "type": "check", "points": 2 },
    { "id": "q35", "text": "Большое хирургическое вмешательство (> 45 мин)", "type": "check", "points": 2 },
