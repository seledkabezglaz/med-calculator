    { "id": "q37", "text": "Эндопротезирование крупных суставов", "type": "check", "points": 5 },
    { "id": "q38", "text": "Перелом костей конечности или таза", "type": "check", "points": 5 },
    { "id": "q39", "text": "Какой-либо дополнительный фактор риска (+1)", "type": "check", "points": 1 }
  ],
  "source": "Caprini JA. Identification of patients at high risk for postoperative VTE. Semin Thromb Hemost. 1991;17(Suppl 3):222-225. PMID: 1754886. Современная версия: Cronin M, et al. Completion of the Updated Caprini Risk Assessment Model (2013 Version). Clin Appl Thromb Hemost. 2019;25:1076029619838052. Адаптация: Пахомов Е.А., actual-phlebology.ru, 2025."
   },
   {
  "id": "rockall_score",
  "type": "questionnaire",
  "name": "Шкала Рокалла (Rockall Score)",
  "specialty": "Гастроэнтерология",
  "description": "Оценка риска повторного кровотечения и летальности при остром кровотечении из верхних отделов ЖКТ. Полная версия (клинические + эндоскопические критерии).",
  "scoring": "sum",
  "questions": [
    { "id": "q1", "text": "Возраст", "options": [
      { "value": 0, "label": "< 60 лет" },
      { "value": 1, "label": "60–79 лет" },
      { "value": 2, "label": "≥ 80 лет" }
    ]},
    { "id": "q2", "text": "Шок", "options": [
      { "value": 0, "label": "Нет шока (АД сист. ≥ 100, пульс < 100)" },
      { "value": 1, "label": "Тахикардия (АД сист. ≥ 100, пульс ≥ 100)" },
      { "value": 2, "label": "Гипотензия (АД сист. < 100)" }
    ]},
    { "id": "q3", "text": "Сопутствующие заболевания", "options": [
      { "value": 0, "label": "Нет серьёзных сопутствующих заболеваний" },
      { "value": 2, "label": "Сердечная недостаточность, ИБС, любое серьёзное сопутствующее заболевание" },
      { "value": 3, "label": "Почечная недостаточность, печёночная недостаточность, диссеминированное злокачественное новообразование" }
    ]},
    { "id": "q4", "text": "Эндоскопический диагноз", "options": [
      { "value": 0, "label": "Синдром Мэллори-Вейсса, нет источника, нет стигм недавнего кровотечения" },
      { "value": 1, "label": "Все другие диагнозы" },
      { "value": 2, "label": "Злокачественное новообразование верхних отделов ЖКТ" }
    ]},
    { "id": "q5", "text": "Признаки недавнего кровотечения (SRH)", "options": [
      { "value": 0, "label": "Нет / только тёмное пятно" },
      { "value": 2, "label": "Кровь в верхних отделах ЖКТ, плотный сгусток, видимый или пульсирующий сосуд" }
    ]}
  ],
  "interpretation": [
    { "min": 0, "max": 3, "label": "Низкий риск (0–2 балла)", "color": "#22c55e" },
    { "min": 3, "max": 6, "label": "Средний риск (3–5 баллов)", "color": "#f59e0b" },
    { "min": 6, "max": 999, "label": "Высокий риск (≥ 6 баллов)", "color": "#ef4444" }
  ],
  "source": "NICE Clinical Guidelines, No. 141. Acute Upper Gastrointestinal Bleeding: Management. 2012. Table 8. Валидация: PMC5473785"
   },
   {
  "id": "glasgow_bleeding",
  "type": "questionnaire",
  "name": "Шкала Глазго-Блэтчфорда (Glasgow-Blatchford Score)",
  "specialty": "Гастроэнтерология",
  "description": "Оценка риска при кровотечении из верхних отделов ЖКТ до эндоскопии.",
  "scoring": "sum",
  "preFields": [
    {
      "id": "m_sex",
      "label": "Пол",
      "type": "radio",
      "options": [
        { "value": 1, "label": "Мужской" },
        { "value": 0, "label": "Женский" }
      ]
    }
  ],
  "questions": [
    { "id": "q1", "text": "Мочевина крови (ммоль/л)", "options": [
      { "value": 0, "label": "< 6,5" },
      { "value": 2, "label": "6,5–7,9" },
      { "value": 3, "label": "8,0–9,9" },
      { "value": 4, "label": "10,0–24,9" },
      { "value": 6, "label": "≥ 25,0" }
    ]},
    { "id": "q2_male", "text": "Гемоглобин (мужчины, г/дл)", "hideIf": "m_sex === 0", "options": [
      { "value": 0, "label": "≥ 13,0" },
      { "value": 1, "label": "12,0–12,9" },
      { "value": 3, "label": "10,0–11,9" },
      { "value": 6, "label": "< 10,0" }
    ]},
    { "id": "q2_female", "text": "Гемоглобин (женщины, г/дл)", "hideIf": "m_sex === 1", "options": [
      { "value": 0, "label": "≥ 12,0" },
      { "value": 1, "label": "10,0–11,9" },
      { "value": 6, "label": "< 10,0" }
    ]},
    { "id": "q3", "text": "Систолическое АД (мм рт. ст.)", "options": [
      { "value": 0, "label": "≥ 110" },
      { "value": 1, "label": "100–109" },
      { "value": 2, "label": "90–99" },
      { "value": 3, "label": "< 90" }
    ]},
    { "id": "q4", "text": "Пульс ≥ 100 уд/мин", "options": [
      { "value": 0, "label": "Нет" },
      { "value": 1, "label": "Да" }
    ]},
    { "id": "q5", "text": "Мелена при поступлении", "options": [
      { "value": 0, "label": "Нет" },
      { "value": 1, "label": "Да" }
    ]},
    { "id": "q6", "text": "Синкопе при поступлении", "options": [
      { "value": 0, "label": "Нет" },
      { "value": 2, "label": "Да" }
    ]},
    { "id": "q7", "text": "Заболевание печени", "options": [
      { "value": 0, "label": "Нет" },
      { "value": 2, "label": "Да" }
    ]},
    { "id": "q8", "text": "Сердечная недостаточность", "options": [
      { "value": 0, "label": "Нет" },
      { "value": 2, "label": "Да" }
    ]}
  ],
  "interpretation": [
    { "min": 0, "max": 1, "label": "Очень низкий риск. Возможна ранняя выписка и амбулаторная эндоскопия.", "color": "#22c55e" },
    { "min": 1, "max": 6, "label": "Низкий–средний риск. Требуется госпитализация и оценка.", "color": "#f59e0b" },
    { "min": 6, "max": 999, "label": "Высокий риск. Показано срочное эндоскопическое вмешательство.", "color": "#ef4444" }
  ],
  "source": "Blatchford O, et al. Lancet. 2000;356(9238):1318-1321."
   },
   {
  "id": "bisap",
  "type": "questionnaire",
  "name": "BISAP (тяжесть острого панкреатита)",
  "specialty": "Гастроэнтерология",
  "description": "Bedside Index for Severity in Acute Pancreatitis — оценка тяжести острого панкреатита у постели больного. 5 критериев, оцениваемых в первые 24 часа.",
  "scoring": "sum",
  "questions": [
    { "id": "q1", "text": "Азот мочевины крови > 25 мг/дл (> 8,9 ммоль/л)", "options": [
      { "value": 0, "label": "Нет" },
      { "value": 1, "label": "Да" }
    ]},
    { "id": "q2", "text": "Нарушение психического статуса (шкала комы Глазго < 15)", "options": [
      { "value": 0, "label": "Нет" },
      { "value": 1, "label": "Да" }
    ]},
    { "id": "q3", "text": "Признаки SIRS (синдром системного воспалительного ответа: ≥2 критериев)", "options": [
      { "value": 0, "label": "Нет" },
      { "value": 1, "label": "Да" }
    ]},
    { "id": "q4", "text": "Возраст > 60 лет", "options": [
      { "value": 0, "label": "Нет" },
      { "value": 1, "label": "Да" }
    ]},
    { "id": "q5", "text": "Плевральный выпот (по данным визуализации)", "options": [
      { "value": 0, "label": "Нет" },
      { "value": 1, "label": "Да" }
    ]}
  ],
  "interpretation": [
    { "min": 0, "max": 3, "label": "Низкая смертность (< 2%)", "color": "#22c55e" },
    { "min": 3, "max": 999, "label": "Высокая смертность (> 15%)", "color": "#ef4444" }
  ],
  "source": "MSD Manuals. BISAP Score. https://www.msdmanuals.com "
   },
   {
  "id": "harvey_bradshaw",
  "type": "questionnaire",
  "name": "Индекс Харви-Брэдшоу (Harvey-Bradshaw Index)",
  "specialty": "Гастроэнтерология",
  "description": "Упрощённая оценка активности болезни Крона за последние 24 часа. Хорошо коррелирует с CDAI.",
  "scoring": "sum",
  "questions": [
    { "id": "q1", "text": "Общее самочувствие (за 24 часа)", "options": [
      { "value": 0, "label": "Очень хорошее" },
      { "value": 1, "label": "Слегка ниже среднего" },
      { "value": 2, "label": "Плохое" },
      { "value": 3, "label": "Очень плохое" },
      { "value": 4, "label": "Ужасное" }
    ]},
    { "id": "q2", "text": "Боль в животе (за 24 часа)", "options": [
      { "value": 0, "label": "Нет" },
      { "value": 1, "label": "Слабая" },
      { "value": 2, "label": "Умеренная" },
      { "value": 3, "label": "Сильная" }
    ]},
    { "id": "q3", "text": "Число жидких дефекаций (за 24 часа)", "options": [
      { "value": 0, "label": "0" }, { "value": 1, "label": "1" }, { "value": 2, "label": "2" },
      { "value": 3, "label": "3" }, { "value": 4, "label": "4" }, { "value": 5, "label": "5" },
      { "value": 6, "label": "6" }, { "value": 7, "label": "7" }, { "value": 8, "label": "8+" }
    ]},
    { "id": "q4", "text": "Абдоминальная масса", "options": [
      { "value": 0, "label": "Нет" },
      { "value": 1, "label": "Сомнительная" },
      { "value": 2, "label": "Определённая" },
      { "value": 3, "label": "Определённая и болезненная" }
    ]},
    { "id": "q5", "text": "Осложнения (каждое +1)", "options": [
      { "value": 0, "label": "Нет" },
      { "value": 1, "label": "1 осложнение" },
      { "value": 2, "label": "2 осложнения" },
      { "value": 3, "label": "3 осложнения" },
      { "value": 4, "label": "4+ осложнения" }
    ]}
  ],
  "interpretation": [
    { "min": 0, "max": 5, "label": "Ремиссия (< 5)", "color": "#22c55e" },
    { "min": 5, "max": 8, "label": "Лёгкая активность (5–7)", "color": "#84cc16" },
    { "min": 8, "max": 17, "label": "Умеренная активность (8–16)", "color": "#f59e0b" },
    { "min": 17, "max": 999, "label": "Тяжёлая активность (> 16)", "color": "#ef4444" }
  ],
  "source": "NHS Scotland. Inflammatory Bowel Disease. Right Decisions."
   },
   {
  "id": "cdai",
  "type": "questionnaire",
  "name": "CDAI (индекс активности болезни Крона)",
  "specialty": "Гастроэнтерология",
  "description": "Crohn's Disease Activity Index. Точный расчёт по 8 компонентам за 7 дней. Введите числовые значения и ответьте на вопросы.",
  "scoring": "sum",
  "preFields": [
    { "id": "m_stools", "label": "Ср. число жидких стула/день", "type": "number", "placeholder": "3", "step": "1" },
    { "id": "m_hct", "label": "Гематокрит (%)", "type": "number", "placeholder": "40", "step": "0.1" },
    {
      "id": "m_hct_norm",
      "label": "Норма гематокрита",
      "type": "radio",
      "options": [
        { "value": 47, "label": "47 (муж.)" },
        { "value": 42, "label": "42 (жен.)" }
      ]
    },
    { "id": "m_weight_loss", "label": "Потеря веса (%)", "type": "number", "placeholder": "0", "step": "0.1" }
  ],
  "calc": [
    { "id": "c_stools", "formula": "m_stools * 14", "decimals": 0, "label": "Стул × 14", "unit": "балл.", "includeInTotal": true },
    { "id": "c_hct", "formula": "Math.max(0, (m_hct_norm - m_hct)) * 6", "decimals": 0, "label": "Откл. Ht × 6", "unit": "балл.", "includeInTotal": true },
    { "id": "c_weight", "formula": "m_weight_loss * 1", "decimals": 0, "label": "Потеря веса × 1", "unit": "балл.", "includeInTotal": true }
  ],
  "questions": [
    { "id": "q2", "text": "Приём дифеноксилата/лоперамида", "options": [
      { "value": 0, "label": "Нет" }, { "value": 30, "label": "Да" }
    ]},
    { "id": "q3", "text": "Интенсивность боли в животе", "options": [
      { "value": 0, "label": "Нет" }, { "value": 35, "label": "Слабая" },
      { "value": 70, "label": "Умеренная" }, { "value": 105, "label": "Сильная" }
    ]},
    { "id": "q4", "text": "Общее самочувствие", "options": [
      { "value": 0, "label": "Хорошее" }, { "value": 49, "label": "Слегка ниже" },
      { "value": 98, "label": "Плохое" }, { "value": 147, "label": "Очень плохое" }, { "value": 196, "label": "Ужасное" }
    ]},
    { "id": "q5", "text": "Осложнения (каждое +20)", "options": [
      { "value": 0, "label": "Нет" }, { "value": 20, "label": "1" }, { "value": 40, "label": "2" },
      { "value": 60, "label": "3" }, { "value": 80, "label": "4+" }
    ]},
    { "id": "q6", "text": "Абдоминальная масса", "options": [
      { "value": 0, "label": "Нет" }, { "value": 20, "label": "Возможная" }, { "value": 50, "label": "Определённая" }
    ]}
  ],
  "interpretation": [
    { "min": 0, "max": 150, "label": "Ремиссия (0–149)", "color": "#22c55e" },
    { "min": 150, "max": 221, "label": "Лёгкая–умеренная активность (150–220)", "color": "#84cc16" },
    { "min": 221, "max": 451, "label": "Умеренная–тяжёлая активность (221–450)", "color": "#f59e0b" },
    { "min": 451, "max": 9999, "label": "Тяжёлая–фульминантная активность (451+)", "color": "#ef4444" }
  ],
  "source": "Best WR, et al. Development of a Crohn's disease activity index. Gastroenterology. 1976;70(3):439-444. MSD Manuals."
    },
        {
      "id": "cardiac_index",
      "type": "formula",
      "name": "Сердечный индекс (СИ)",
      "specialty": "Гемодинамика",
      "description": "Отношение сердечного выброса (МОК) к площади поверхности тела. Отражает насосную функцию сердца, приведённую к площади тела.",
      "fields": [
        { "id": "m_co", "label": "Сердечный выброс (л/мин)", "type": "number", "placeholder": "5.0", "step": "0.1" },
        { "id": "m_weight", "label": "Вес (кг)", "type": "number", "placeholder": "70", "step": "0.1" },
        { "id": "m_height", "label": "Рост (см)", "type": "number", "placeholder": "175", "step": "1" }
      ],
      "formula": "m_co / Math.sqrt((m_weight * m_height) / 3600)",
      "unit": "л/мин/м²",
      "decimals": 2,
      "interpretation": [
        { "min": 0, "max": 2.2, "label": "Гипокинетический тип (СИ < 2,2)", "color": "#3b82f6" },
        { "min": 2.2, "max": 2.7, "label": "Норма (2,2–2,7)", "color": "#22c55e" },
        { "min": 2.7, "max": 3.5, "label": "Эукинетический тип (2,7–3,5)", "color": "#22c55e" },
        { "min": 3.5, "max": 999, "label": "Гиперкинетический тип (> 3,5)", "color": "#f59e0b" }
      ],
      "source": "Норма: 2,2–2,4 л/мин/м². Типы гемодинамики по СИ."
    },
    {
      "id": "stroke_index",
      "type": "formula",
      "name": "Ударный индекс (УИ)",
      "specialty": "Гемодинамика",
      "description": "Отношение ударного объёма (УО) к площади поверхности тела. Позволяет сравнивать сократительную функцию у пациентов разного телосложения.",
      "fields": [
        { "id": "m_sv", "label": "Ударный объём (мл)", "type": "number", "placeholder": "70", "step": "1" },
        { "id": "m_weight", "label": "Вес (кг)", "type": "number", "placeholder": "70", "step": "0.1" },
        { "id": "m_height", "label": "Рост (см)", "type": "number", "placeholder": "175", "step": "1" }
      ],
      "formula": "m_sv / Math.sqrt((m_weight * m_height) / 3600)",
      "unit": "мл/м²",
      "decimals": 1,
      "interpretation": [
        { "min": 0, "max": 36, "label": "Ниже нормы (< 36 мл/м²)", "color": "#3b82f6" },
        { "min": 36, "max": 48, "label": "Норма (36–48 мл/м²)", "color": "#22c55e" },
        { "min": 48, "max": 999, "label": "Выше нормы (> 48 мл/м²)", "color": "#f59e0b" }
      ],
      "source": "Норма 36–48 мл/м². Альтернативные диапазоны: 42–47±8,5; 45–55 мл/м²."
    },
    {
      "id": "oxygen_delivery",
      "type": "formula",
      "name": "Доставка кислорода (DO₂)",
      "specialty": "Гемодинамика",
      "description": "Общее количество кислорода, доставляемого тканям за минуту. Зависит от сердечного выброса и содержания кислорода в артериальной крови.",
      "fields": [
        { "id": "m_co", "label": "Сердечный выброс (л/мин)", "type": "number", "placeholder": "5.0", "step": "0.1" },
        { "id": "m_hb", "label": "Гемоглобин (г/л)", "type": "number", "placeholder": "140", "step": "1" },
        { "id": "m_sao2", "label": "Сатурация артериальной крови SaO₂ (%)", "type": "number", "placeholder": "98", "step": "1" },
        { "id": "m_pao2", "label": "PaO₂ (мм рт. ст.)", "type": "number", "placeholder": "90", "step": "1" }
      ],
      "formula": "m_co * (m_hb * 1.39 * (m_sao2 / 100) + 0.0031 * m_pao2)",
      "unit": "мл/мин",
      "decimals": 0,
      "interpretation": [
        { "min": 0, "max": 600, "label": "Сниженная доставка кислорода", "color": "#ef4444" },
        { "min": 600, "max": 1200, "label": "Нормальная доставка (900–1100 мл/мин)", "color": "#22c55e" },
        { "min": 1200, "max": 9999, "label": "Повышенная доставка кислорода", "color": "#f59e0b" }
      ],
      "source": "Формула: DO₂ = CO × (Hb × 1,39 × SaO₂ + 0,0031 × PaO₂). Норма ~1000 мл/мин."
    },
    {
      "id": "oxygen_extraction_ratio",
      "type": "formula",
      "name": "Коэффициент экстракции кислорода (O₂ER)",
      "specialty": "Гемодинамика",
      "description": "Доля кислорода, извлекаемая тканями из доставляемого объёма. Отражает баланс между доставкой и потреблением кислорода.",
      "fields": [
        { "id": "m_sao2", "label": "Сатурация артериальной крови SaO₂ (%)", "type": "number", "placeholder": "98", "step": "1" },
        { "id": "m_svo2", "label": "Сатурация смешанной венозной крови SvO₂ (%)", "type": "number", "placeholder": "75", "step": "1" }
      ],
      "formula": "((m_sao2 - m_svo2) / m_sao2) * 100",
      "unit": "%",
      "decimals": 1,
      "interpretation": [
        { "min": 0, "max": 20, "label": "Сниженная экстракция (< 20%) — доставка превышает потребность", "color": "#3b82f6" },
        { "min": 20, "max": 31, "label": "Норма (20–30%)", "color": "#22c55e" },
        { "min": 31, "max": 999, "label": "Повышенная экстракция (> 30%) — доставка ограничена", "color": "#ef4444" }
      ],
      "source": "Норма 20–30%. Формула O₂ER = (SaO₂ − SvO₂) / SaO₂."
    },
    {
      "id": "svri",
      "type": "formula",
      "name": "Индекс сосудистого сопротивления (SVRI)",
      "specialty": "Гемодинамика",
      "description": "Системное сосудистое сопротивление, приведённое к площади поверхности тела. Отражает тонус периферических сосудов.",
      "fields": [
        { "id": "m_map", "label": "Среднее артериальное давление (мм рт. ст.)", "type": "number", "placeholder": "90", "step": "1" },
        { "id": "m_cvp", "label": "Центральное венозное давление (мм рт. ст.)", "type": "number", "placeholder": "5", "step": "1" },
        { "id": "m_ci", "label": "Сердечный индекс (л/мин/м²)", "type": "number", "placeholder": "3.0", "step": "0.1" }
      ],
      "formula": "79.9 * (m_map - m_cvp) / m_ci",
      "unit": "дин·с/см⁵/м²",
      "decimals": 0,
      "interpretation": [
        { "min": 0, "max": 800, "label": "Сниженное сопротивление (< 800) — вазодилатация", "color": "#3b82f6" },
        { "min": 800, "max": 1600, "label": "Норма (800–1600)", "color": "#22c55e" },
        { "min": 1600, "max": 99999, "label": "Повышенное сопротивление (> 1600) — вазоконстрикция", "color": "#ef4444" }
      ],
      "source": "Формула: SVRI = 79,9 × (MAP − CVP) / CI. Норма 800–1600 дин·с/см⁵/м²."
    },
    {
  "id": "lvswi",
  "type": "formula",
  "name": "Индекс ударной работы ЛЖ (LVSWI)",
  "specialty": "Гемодинамика",
  "description": "Оценка работы левого желудочка за одно сокращение, приведённая к площади тела. Отражает сократительную способность и условия нагрузки.",
  "fields": [
    { "id": "m_svi", "label": "Ударный индекс (мл/м²)", "type": "number", "placeholder": "45", "step": "1" },
    { "id": "m_map", "label": "Среднее артериальное давление (мм рт. ст.)", "type": "number", "placeholder": "90", "step": "1" },
    { "id": "m_pawp", "label": "Давление заклинивания (PAWP, мм рт. ст.)", "type": "number", "placeholder": "10", "step": "1" }
  ],
  "formula": "m_svi * (m_map - m_pawp) * 0.0136",
  "unit": "г·м/м²",
  "decimals": 1,
  "interpretation": [
    { "min": 0, "max": 50, "label": "Сниженная работа ЛЖ (< 50 г·м/м²)", "color": "#3b82f6" },
    { "min": 50, "max": 62, "label": "Норма (50–62 г·м/м²)", "color": "#22c55e" },
    { "min": 62, "max": 999, "label": "Повышенная работа ЛЖ (> 62 г·м/м²)", "color": "#f59e0b" }
  ],
  "source": "Edwards Lifesciences. DOC-0140282A. ScyMed. LVSWI Equation. Норма: 50–62 г·м/м²."
    },
    {
  "id": "cao2",
  "type": "formula",
  "name": "Содержание кислорода в артериальной крови (CaO₂)",
  "specialty": "Гемодинамика",
  "description": "Общее количество кислорода, связанного с гемоглобином и растворённого в плазме артериальной крови.",
  "fields": [
    { "id": "m_hb", "label": "Гемоглобин (г/дл)", "type": "number", "placeholder": "14", "step": "0.1" },
    { "id": "m_sao2", "label": "Сатурация артериальной крови SaO₂ (%)", "type": "number", "placeholder": "98", "step": "1" },
    { "id": "m_pao2", "label": "PaO₂ (мм рт. ст.)", "type": "number", "placeholder": "90", "step": "1" }
  ],
  "formula": "(m_hb * 1.34 * (m_sao2 / 100)) + (m_pao2 * 0.0031)",
  "unit": "мл/дл",
  "decimals": 2,
  "interpretation": [
    { "min": 0, "max": 17, "label": "Сниженное содержание O₂ (< 17 мл/дл)", "color": "#3b82f6" },
    { "min": 17, "max": 21, "label": "Норма (17–20 мл/дл)", "color": "#22c55e" },
    { "min": 21, "max": 999, "label": "Повышенное содержание O₂ (> 20 мл/дл)", "color": "#f59e0b" }
  ],
  "source": "PMC8905304. ScyMed. Ca-vO2 Equation. Норма CaO₂: 17–20 мл/дл."
    },
    {
  "id": "avo2_diff",
  "type": "formula",
  "name": "Артериовенозная разница по O₂ (a-vDO₂)",
  "specialty": "Гемодинамика",
  "description": "Разница между содержанием кислорода в артериальной и смешанной венозной крови. Отражает потребление кислорода тканями.",
  "fields": [
    { "id": "m_hb", "label": "Гемоглобин (г/дл)", "type": "number", "placeholder": "14", "step": "0.1" },
    { "id": "m_sao2", "label": "Сатурация артериальной крови SaO₂ (%)", "type": "number", "placeholder": "98", "step": "1" },
    { "id": "m_pao2", "label": "PaO₂ (мм рт. ст.)", "type": "number", "placeholder": "90", "step": "1" },
    { "id": "m_svo2", "label": "Сатурация смешанной венозной крови SvO₂ (%)", "type": "number", "placeholder": "75", "step": "1" },
    { "id": "m_pvo2", "label": "PvO₂ (мм рт. ст.)", "type": "number", "placeholder": "40", "step": "1" }
  ],
  "formula": "((m_hb * 1.34 * (m_sao2 / 100)) + (m_pao2 * 0.0031)) - ((m_hb * 1.34 * (m_svo2 / 100)) + (m_pvo2 * 0.0031))",
  "unit": "мл/дл",
  "decimals": 2,
  "interpretation": [
    { "min": 0, "max": 5, "label": "Норма (≤ 5 мл/дл)", "color": "#22c55e" },
    { "min": 5, "max": 999, "label": "Повышенная экстракция O₂ (> 5 мл/дл) — усиленное потребление", "color": "#ef4444" }
  ],
  "source": "Innovmedkub. PMC8905304. Норма a-vDO₂ ≤ 5 мл/дл."
    },
    {
  "id": "child_pugh",
  "type": "questionnaire",
  "name": "Шкала Чайлд-Пью (Child-Pugh)",
  "specialty": "Гепатология",
  "description": "Оценка тяжести цирроза печени и прогноза выживаемости. 5 параметров: билирубин, альбумин, МНО, асцит, энцефалопатия.",
  "scoring": "sum",
  "questions": [
    { "id": "q1", "text": "Общий билирубин (мкмоль/л)", "options": [
      { "value": 1, "label": "< 34" },
      { "value": 2, "label": "34–50" },
      { "value": 3, "label": "> 50" }
    ]},
    { "id": "q2", "text": "Альбумин (г/л)", "options": [
      { "value": 1, "label": "> 35" },
      { "value": 2, "label": "28–35" },
      { "value": 3, "label": "< 28" }
    ]},
    { "id": "q3", "text": "МНО (протромбиновое время)", "options": [
      { "value": 1, "label": "< 1,7" },
      { "value": 2, "label": "1,7–2,3" },
      { "value": 3, "label": "> 2,3" }
    ]},
    { "id": "q4", "text": "Асцит", "options": [
      { "value": 1, "label": "Нет" },
      { "value": 2, "label": "Лёгкий (контролируется диуретиками)" },
      { "value": 3, "label": "Умеренный/выраженный (резистентный)" }
    ]},
    { "id": "q5", "text": "Печёночная энцефалопатия", "options": [
      { "value": 1, "label": "Нет" },
      { "value": 2, "label": "Степень 1–2" },
      { "value": 3, "label": "Степень 3–4" }
    ]}
  ],
  "interpretation": [
    { "min": 5, "max": 7, "label": "Класс A (5–6 баллов). Компенсированный цирроз. 1-летняя выживаемость 84–96%.", "color": "#22c55e" },
    { "min": 7, "max": 10, "label": "Класс B (7–9 баллов). Субкомпенсированный цирроз. 1-летняя выживаемость 62–78%.", "color": "#f59e0b" },
    { "min": 10, "max": 999, "label": "Класс C (10–15 баллов). Декомпенсированный цирроз. 1-летняя выживаемость 41–51%.", "color": "#ef4444" }
  ],
  "source": "Universitätsklinikum Ulm. MSD Manuals. Pugh RN, et al. Br J Surg. 1973. Evigrade."
    },
    {
  "id": "meld_score",
  "type": "formula",
  "name": "Шкала MELD 3.0",
  "specialty": "Гепатология",
  "description": "Model for End-Stage Liver Disease 3.0. Оценка тяжести терминальной стадии заболевания печени и 90-дневной выживаемости. Используется для приоритизации в листе ожидания трансплантации.",
  "fields": [
    {
      "id": "m_sex",
      "label": "Пол",
      "type": "radio",
      "options": [
        { "value": 0, "label": "Мужской" },
        { "value": 1.33, "label": "Женский" }
      ]
    },
    { "id": "m_bili", "label": "Общий билирубин (мг/дл)", "type": "number", "placeholder": "1.5", "step": "0.1" },
    { "id": "m_inr", "label": "МНО (INR)", "type": "number", "placeholder": "1.2", "step": "0.1" },
    { "id": "m_creat", "label": "Креатинин сыворотки (мг/дл)", "type": "number", "placeholder": "1.0", "step": "0.1" },
    { "id": "m_sodium", "label": "Натрий сыворотки (мЭкв/л)", "type": "number", "placeholder": "137", "step": "1" },
    { "id": "m_albumin", "label": "Альбумин сыворотки (г/дл)", "type": "number", "placeholder": "3.5", "step": "0.1" }
  ],
  "formula": "(() => { const bili = Math.max(1, m_bili); const inr = Math.max(1, m_inr); const creat = Math.min(3, Math.max(1, m_creat)); const na = Math.min(137, Math.max(125, m_sodium)); const alb = Math.min(3.5, Math.max(1.5, m_albumin)); return Math.round(m_sex + (4.56 * Math.log(bili)) + (0.82 * (137 - na)) - (0.24 * (137 - na) * Math.log(bili)) + (9.09 * Math.log(inr)) + (11.14 * Math.log(creat)) + (1.85 * (3.5 - alb)) - (1.83 * (3.5 - alb) * Math.log(creat)) + 6); })()",
  "unit": "баллов",
  "decimals": 0,
  "interpretation": [
    { "min": 0, "max": 10, "label": "MELD 6–9. Низкий риск. 3-месячная смертность < 2%.", "color": "#22c55e" },
    { "min": 10, "max": 20, "label": "MELD 10–19. Умеренный риск. 3-месячная смертность ~6%.", "color": "#84cc16" },
    { "min": 20, "max": 30, "label": "MELD 20–29. Высокий риск. 3-месячная смертность ~20%.", "color": "#f59e0b" },
    { "min": 30, "max": 999, "label": "MELD ≥ 30. Очень высокий риск. 3-месячная смертность > 50%.", "color": "#ef4444" }
  ],
  "source": "Kim WR, et al. MELD 3.0. Gastroenterology. 2021;161:1887. OPTN MELD/PELD Calculator User Guide."
    }
  ]
}
